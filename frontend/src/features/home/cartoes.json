  {
   "id": "longe-de-ptt",
   "titulo": "Municípios a mais de 100 km de um PTT",
   "pergunta": "Quais municípios com mais de 5 mil acessos de banda larga ficam longe de um PTT?",
   "consulta": {
    "tipo": "derivado",
    "id": "longe-de-ptt",
    "consultas": [
     {
      "colecao": "acessos_municipio",
      "corpo": {
       "filter": {
        "field": "municipio_acessos",
        "op": "gte",
        "value": 5000
       },
       "group_by": [
        "ibge",
        "municipio",
        "uf"
       ],
       "aggregate": [
        {
         "fn": "max",
         "field": "municipio_acessos",
         "as": "acessos"
        }
       ]
      }
     }
    ]
   },
   "linha": {
    "rotulo": "municipio",
    "complemento": "uf",
    "valor": "km",
    "unidade": "km do PTT",
    "link": "/municipio/{ibge}"
   },
   "destino": {
    "to": "/localizador",
    "rotulo": "Abrir o localizador"
   },
   "fontes": [
    "anatel_sici",
    "curada_pix"
