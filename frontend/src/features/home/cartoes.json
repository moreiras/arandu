         },
         {
          "field": "cnpj",
          "op": "exists",
          "value": true
         },
         {
          "field": "apnic_users",
          "op": "gte",
          "value": 3000
         }
        ]
       },
       "select": [
        "asn",
        "cnpj",
        "apnic_users"
       ],
       "sort": [
        {
         "field": "apnic_users",
         "dir": "desc"
        }
       ],
       "limit": 1000
      }
     },
     {
      "colecao": "operadoras",
      "corpo": {
       "filter": {
        "and": [
         {
          "field": "licenciado",
          "op": "eq",
          "value": true
         },
         {
          "field": "ativo",
          "op": "eq",
          "value": false
         },
         {
          "field": "cnpj",
          "op": "in",
          "value": "$cnpjs"
         }
        ]
       },
       "select": [
        "cnpj",
        "razao_social"
