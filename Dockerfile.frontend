# Versão do nginx servida: a MESMA para o binário (estágio 3) e para os módulos brotli (estágio 2), que só carregam no binário da
# versão contra a qual foram compilados. Ao trocar, atualize NGINX_VERSION, NGINX_PKG_REL e NGINX_SHA256 juntos.
ARG NGINX_VERSION=1.30.7

# Estágio 1: build do React com Vite
# Pinado por digest para builds reproduzíveis. Atualizar com: docker pull node:22-slim
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ .
# Versão do sistema (fonte única: VERSION na raiz); lida pelo vite.config.ts
COPY VERSION ./VERSION
# Identidade do site: vem do .env pelo `build.args` do compose. Vazio = padrão de src/lib/site.ts.
ARG SITE_NOME=""
ARG SITE_NOME_EXTENSO=""
ARG SITE_URL=""
ARG SITE_MCP_ESQUEMA=""
ARG SITE_PREFIXO_ARQUIVOS=""
ARG SITE_SOFTWARE=""
ARG SITE_CONTATO=""
ARG SITE_CONTATO_PRIVACIDADE=""
ARG SITE_CODIGO_FONTE=""
ENV VITE_SITE_NOME=$SITE_NOME VITE_SITE_NOME_EXTENSO=$SITE_NOME_EXTENSO VITE_SITE_URL=$SITE_URL VITE_SITE_MCP_ESQUEMA=$SITE_MCP_ESQUEMA \
    VITE_SITE_PREFIXO_ARQUIVOS=$SITE_PREFIXO_ARQUIVOS VITE_SITE_SOFTWARE=$SITE_SOFTWARE VITE_SITE_CONTATO=$SITE_CONTATO \
    VITE_SITE_CONTATO_PRIVACIDADE=$SITE_CONTATO_PRIVACIDADE \
    VITE_SITE_CODIGO_FONTE=$SITE_CODIGO_FONTE
# Marca da instância (fora do repositório, instancia/README.md): substitui o símbolo e os ícones padrão do software em public/.
COPY instancia/ ./instancia/
RUN if [ -d instancia/marca ]; then cp -a instancia/marca/. public/; fi && rm -rf instancia
RUN npm run build

# Estágio 2: módulos brotli do nginx (ngx_brotli), compilados contra o MESMO nginx da imagem final
# (a imagem oficial não traz brotli). `--with-compat` gera módulos dinâmicos carregáveis pelo binário
# oficial. Versão do nginx e commit do ngx_brotli (com o submódulo brotli v1.2.1) pinados; o tarball é
# conferido por sha256 (o da 1.30.7 foi tirado do tarball cuja assinatura PGP de nginx.org/en/pgp_keys.html conferiu).
FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e AS brotli
USER root
ARG NGINX_VERSION
ARG NGINX_SHA256=2565b5c837050e958f70fb0f73c48e2bca4542ad349fd356f46fb0c72610bc6e
ARG NGX_BROTLI_COMMIT=53e0fb55f250f48fe80c0ddbf6c0f7103cdbaae1
RUN apk add --no-cache build-base cmake git curl linux-headers pcre2-dev zlib-dev openssl-dev
WORKDIR /build
# Novas tentativas com tempo limite por tentativa: no ambiente de teste o download de nginx.org às vezes trava no meio e termina em
# "Connection reset by peer". O sha256 continua conferindo o arquivo.
RUN curl -fsSL --retry 6 --retry-delay 10 --retry-all-errors --connect-timeout 20 --max-time 120 \
      -o nginx.tar.gz "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" \
 && echo "${NGINX_SHA256}  nginx.tar.gz" | sha256sum -c - \
 && tar xzf nginx.tar.gz
RUN git clone https://github.com/google/ngx_brotli.git \
 && cd ngx_brotli && git checkout "${NGX_BROTLI_COMMIT}" && git submodule update --init --recursive
# A biblioteca brotli (submódulo) é compilada estática e com -fPIC antes, como manda o README do ngx_brotli.
RUN cd ngx_brotli/deps/brotli && mkdir out && cd out \
 && cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DCMAKE_C_FLAGS="-O2 -fPIC" \
      -DCMAKE_INSTALL_PREFIX=./installed .. \
 && cmake --build . --config Release --target brotlienc
RUN cd "nginx-${NGINX_VERSION}" \
 && ./configure --with-compat --add-dynamic-module=../ngx_brotli \
 && make modules \
 && mkdir /build/modulos && cp objs/ngx_http_brotli_filter_module.so objs/ngx_http_brotli_static_module.so /build/modulos/

# Estágio 3: serve os arquivos estáticos com Nginx
# nginx-unprivileged roda como uid 101 desde o início — sem root, sem SETUID/SETGID/CHOWN.
# Pinado por digest para builds reproduzíveis. Atualizar com: docker pull nginxinc/nginx-unprivileged:1.30-alpine
FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
USER root
# A imagem-base congela os pacotes do dia em que foi gerada. Aqui:
# - saem os módulos dinâmicos que a configuração não carrega (geoip, image-filter, njs, xslt): menos bibliotecas na imagem, e eles
#   travariam a troca de versão do nginx (cada um exige o nginx da mesma versão);
# - `apk upgrade` traz as correções do Alpine publicadas depois da imagem;
# - o nginx vem na versão NGINX_VERSION do repositório de pacotes do nginx.org (a chave que confere a assinatura já está em
#   /etc/apk/keys da imagem-base), para não esperar a imagem oficial ser refeita a cada correção de segurança.
# O build falha se o nginx instalado não for o esperado ou se a configuração herdada da imagem unprivileged não sobreviver.
ARG NGINX_VERSION
ARG NGINX_PKG_REL=r1
# Imagem-base atualizada (Dependabot) com nginx mais novo que NGINX_VERSION: falha em vez de rebaixar o nginx em silêncio.
RUN base="$(nginx -v 2>&1 | sed 's#.*/##')" \
 && [ "$(printf '%s\n%s\n' "$base" "$NGINX_VERSION" | sort -V | tail -1)" = "$NGINX_VERSION" ] \
 || { echo "a imagem-base traz nginx $base, mais novo que NGINX_VERSION=$NGINX_VERSION: atualize NGINX_VERSION, NGINX_PKG_REL e NGINX_SHA256" >&2; exit 1; }
RUN apk del --no-cache nginx-module-geoip nginx-module-image-filter nginx-module-njs nginx-module-xslt \
 && apk upgrade --no-cache \
 && apk add --no-cache --repository "https://nginx.org/packages/alpine/v$(cut -d. -f1,2 /etc/alpine-release)/main" \
      "nginx=${NGINX_VERSION}-${NGINX_PKG_REL}" \
 && nginx -v 2>&1 | grep -qx "nginx version: nginx/${NGINX_VERSION}" \
 && grep -q '/tmp/nginx.pid' /etc/nginx/nginx.conf

# Módulos brotli: carregados no topo do nginx.conf (load_module só vale no contexto principal).
# O sed roda como root e o usuário volta para o uid 101 do nginx-unprivileged.
COPY --from=brotli /build/modulos/ngx_http_brotli_filter_module.so /build/modulos/ngx_http_brotli_static_module.so /usr/lib/nginx/modules/
RUN printf 'load_module modules/ngx_http_brotli_filter_module.so;\nload_module modules/ngx_http_brotli_static_module.so;\n' | cat - /etc/nginx/nginx.conf > /tmp/nginx.conf \
 && mv /tmp/nginx.conf /etc/nginx/nginx.conf
USER 101

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf    /etc/nginx/conf.d/default.conf
COPY docker/nginx-security-headers.conf /etc/nginx/conf.d/security-headers.conf
COPY docker/nginx-api-proxy.inc         /etc/nginx/conf.d/api-proxy.inc
COPY docker/nginx-real-ip.inc           /etc/nginx/conf.d/real-ip.inc

EXPOSE 80
