{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento do histórico (events/{date}.jsonl.gz)",
  "type": "object",
  "required": [
    "id",
    "data",
    "tipo",
    "entidade",
    "chave",
    "janela",
    "estado",
    "confirmado"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tipo": {
      "type": "string"
    },
    "entidade": {
      "type": "string",
      "pattern": "^(asn|ixp|cnpj|prefixo):"
    },
    "chave": {
      "type": "string"
    },
    "janela": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "estado": {
      "enum": [
        "pendente",
        "confirmado",
        "revertido"
      ]
    },
    "confirmado": {
      "type": "boolean"
    },
    "confirmado_em": {
      "type": "string"
    },
    "revertido_em": {
      "type": "string"
    },
    "destaque": {
      "type": "boolean"
    },
    "asn": {
      "type": "integer"
    },
    "uf": {
      "type": "string"
    },
    "detalhe": {
      "type": "object"
    }
  }
}
