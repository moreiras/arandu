{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Índice do histórico (history/index.json)",
  "type": "object",
  "required": [
    "schema_version",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "asn_linhas"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "asn_linhas": {
            "type": "integer",
            "minimum": 0
          },
          "eventos_n": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
