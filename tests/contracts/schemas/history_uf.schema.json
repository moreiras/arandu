{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linha de histórico de UF (weekly/{date}/uf.jsonl.gz)",
  "type": "object",
  "required": [
    "uf",
    "n_asns",
    "n_cnpjs"
  ],
  "properties": {
    "uf": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "n_asns": {
      "type": "integer",
      "minimum": 0
    },
    "n_cnpjs": {
      "type": "integer",
      "minimum": 0
    },
    "users": {
      "type": "integer",
      "minimum": 0
    },
    "v6users": {
      "type": "integer",
      "minimum": 0
    },
    "users_ma4": {
      "type": "number",
      "minimum": 0
    },
    "n_ma4": {
      "type": "integer",
      "minimum": 1
    },
    "p4": {
      "type": "integer",
      "minimum": 0
    },
    "p6": {
      "type": "integer",
      "minimum": 0
    },
    "n_roa": {
      "type": "integer",
      "minimum": 0
    },
    "rpki_valid": {
      "type": "integer",
      "minimum": 0
    },
    "rpki_invalid": {
      "type": "integer",
      "minimum": 0
    },
    "rpki_not_found": {
      "type": "integer",
      "minimum": 0
    }
  }
}
