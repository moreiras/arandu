{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linha de histórico de operadora (weekly/{date}/operadora.jsonl.gz)",
  "type": "object",
  "required": [
    "cnpj",
    "n_asns"
  ],
  "properties": {
    "cnpj": {
      "type": "string",
      "pattern": "^[0-9]{14}$"
    },
    "grupo_id": {
      "type": "string"
    },
    "n_asns": {
      "type": "integer",
      "minimum": 0
    },
    "users": {
      "type": "integer",
      "minimum": 0
    },
    "v6users": {
      "type": "integer",
      "minimum": 0
    },
    "users_ma4": {
      "type": "number",
      "minimum": 0
    },
    "n_ma4": {
      "type": "integer",
      "minimum": 1
    },
    "p4": {
      "type": "integer",
      "minimum": 0
    },
    "p6": {
      "type": "integer",
      "minimum": 0
    },
    "n_ixd": {
      "type": "integer",
      "minimum": 0
    },
    "n_roa": {
      "type": "integer",
      "minimum": 0
    },
    "rpki_valid": {
      "type": "integer",
      "minimum": 0
    },
    "rpki_invalid": {
      "type": "integer",
      "minimum": 0
    },
    "rpki_not_found": {
      "type": "integer",
      "minimum": 0
    },
    "n_alertas": {
      "type": "integer",
      "minimum": 0
    }
  }
}
